<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hkjc.oddslogger</string>

  <!-- Wrapper decides if today is a race day and which venue; exits fast otherwise. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__PROJECT_DIR__/scripts/log_odds_day.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>

  <!-- Fire twice daily (local time = HKT if the Mac is set to Hong Kong):
       ~11:30 covers Sha Tin day meetings (first race ~13:00);
       ~17:30 covers night meetings (first race ~19:15). -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>30</integer></dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/logs/oddslogger.launchd.out</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/logs/oddslogger.launchd.err</string>

  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
